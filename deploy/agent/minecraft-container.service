[Unit]
Description=Start Minecraft Docker container on host boot
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/mc-server-agent.env
ExecStart=/usr/bin/docker start ${MC_AGENT_CONTAINER}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
