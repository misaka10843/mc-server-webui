[Unit]
Description=Minecraft server host agent
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=mc-agent
Group=mc-agent
SupplementaryGroups=docker
WorkingDirectory=/opt/mc-server-webui
EnvironmentFile=/etc/mc-server-agent.env
Environment=PYTHONPATH=/opt/mc-server-webui/agent
ExecStart=/opt/mc-server-webui/.venv/bin/python -m mc_agent.main
Restart=on-failure
RestartSec=5
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
